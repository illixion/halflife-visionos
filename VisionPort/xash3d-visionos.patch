+// Lambda VisionPro split: extract Host_Main's init body and per-frame step
+// into Host_DoInit / Host_DoFrame so the visionOS app can drive the engine
+// from CompositorServices instead of owning main().
+static double s_lambda_oldtime;
+
+int EXPORT Host_DoInit( int argc, char **argv, const char *progname, int bChangeGame, pfnChangeGame pChangeGame );
+int EXPORT Host_DoFrame( void );
