+	float fovx = rvp->fov_x ? rvp->fov_x : 90.0f;
+	float fovy = rvp->fov_y ? rvp->fov_y : 60.0f;
+	float fx = 1.0f / tanf( fovx * 0.5f * (float)M_PI / 180.0f );
+	float fy = 1.0f / tanf( fovy * 0.5f * (float)M_PI / 180.0f );
