+
+static void RAM_Close( searchpath_t *search )
+{
+}
+
+/*
+============
+build thread
+============
+*/
+typedef struct
+{
+	ramcache_t *rc;
+	int generation;
+} ram_job_t;
+
+static void *RAM_BuildThread( void *arg )
+{
+	ram_job_t *job = arg;
+	ramcache_t *rc = job->rc;
+	uint64_t t0 = FS_IONow();
+	size_t d;
+	int i;
+
+	pthread_setname_np( "xash.fs-ramcache" );
+
+	RAM_Walk( rc, "" );
+	RAM_BuildTable( rc );
+
+	// absence is only known where nothing else can have the directory
+	if( !rc->has_archives && !rc->read_failed )
+	{
+		for( d = 0; d < RAM_NUM_NEGATIVE_DIRS; d++ )
+		{
+			qboolean elsewhere = false;
+
+			for( i = 0; i < rc->numothers && !elsewhere; i++ )
+				elsewhere = RAM_PathExists( rc->others[i], ram_negative_dirs[d] );
+
+			if( !elsewhere )
+				SetBits( rc->negative_ok, BIT( d ));
+		}
+
+		// the map's WAD list names WADs bare; ones that don't exist would
+		// otherwise relist every search path's root, once per name
+		rc->negative_root_wads = true;
+		for( i = 0; i < rc->numothers && rc->negative_root_wads; i++ )
+			rc->negative_root_wads = !RAM_RootHasWad( rc->others[i] );
+	}
+
+	rc->build_ms = ( FS_IONow() - t0 ) / 1e6;
+
+	if( atomic_load( &fs_ram_generation ) == job->generation )
+	{
+		fs_iostats.ram_files = rc->numfiles;
+		fs_iostats.ram_bytes = rc->bytes;
+		fs_iostats.ram_build_ms = rc->build_ms;
+		atomic_store_explicit( &fs_ram, rc, memory_order_release );
+	}
+	// else: the paths changed while building; it stays retired and unused
+
+	atomic_store( &fs_ram_building, 0 );
+	free( job );
+	return NULL;
+}
+
+static qboolean RAM_SameLayout( const ramcache_t *a, const ramcache_t *b )
+{
+	int i;
+
+	if( Q_strcmp( a->root, b->root ) || a->numshadows != b->numshadows
+		|| a->numothers != b->numothers || a->has_archives != b->has_archives )
+		return false;
+
+	for( i = 0; i < a->numshadows; i++ )
+		if( Q_strcmp( a->shadows[i], b->shadows[i] ))
+			return false;
+	for( i = 0; i < a->numothers; i++ )
+		if( Q_strcmp( a->others[i], b->others[i] ))
+			return false;
+	return true;
+}
+
+void FS_RamCacheInvalidate( void )
+{
+	atomic_fetch_add( &fs_ram_generation, 1 );
+	atomic_store_explicit( &fs_ram, NULL, memory_order_release );
+}
+
+void FS_RamCacheStart( searchpath_t *searchpaths, const char *rodir, const char *gamefolder )
+{
+	char root[MAX_SYSPATH];
+	const char *env = getenv( "XASH_FS_RAMCACHE" );
+	searchpath_t *sp;
+	ramcache_t *rc, *old;
+	qboolean before_root = true, found_root = false;
+	pthread_t thread;
+	pthread_attr_t attr;
+	ram_job_t *job;
+
+#if XASH_VISIONOS
+	if( env && env[0] == '0' )
+		return;
+#else
+	if( !env || env[0] != '1' )
+		return;
+#endif
+
+	if( COM_StringEmptyOrNULL( rodir ) || COM_StringEmptyOrNULL( gamefolder ))
+		return;
+
+	Q_snprintf( root, sizeof( root ), "%s/%s/", rodir, gamefolder );
+
+	rc = calloc( 1, sizeof( *rc ));
+	Q_strncpy( rc->root, root, sizeof( rc->root ));
+
+	for( sp = searchpaths; sp; sp = sp->next )
+	{
+		if( sp->type == SEARCHPATH_PAK || sp->type == SEARCHPATH_ZIP
+			|| sp->type == SEARCHPATH_PK3DIR || sp->type == SEARCHPATH_ANDROID_ASSETS )
+		{
+			rc->has_archives = true;
+			continue;
+		}
+
+		if( sp->type != SEARCHPATH_PLAIN )
+			continue; // WADs: only lump types, none of which the mirror covers
+
+		if( !Q_strcmp( sp->filename, root ))
+		{
+			before_root = false;
+			found_root = true;
+			rc->root_flags = sp->flags;
+			continue;
+		}
+
+		if( before_root && rc->numshadows < RAM_MAX_PATHS )
+			Q_strncpy( rc->shadows[rc->numshadows++], sp->filename, MAX_SYSPATH );
+		if( rc->numothers < RAM_MAX_PATHS )
+			Q_strncpy( rc->others[rc->numothers++], sp->filename, MAX_SYSPATH );
+		else rc->has_archives = true; // too many to reason about; no absence answers
+	}
+
+	if( !found_root )
+	{
+		free( rc );
+		return;
+	}
+
+	// a rescan with the same layout reuses what is already in memory
+	for( old = fs_ram_retired; old; old = old->next_retired )
+	{
+		if( old->slots && RAM_SameLayout( old, rc ))
+		{
+			free( rc );
+			atomic_fetch_add( &fs_ram_generation, 1 );
+			atomic_store_explicit( &fs_ram, old, memory_order_release );
+			return;
+		}
+	}
+
+	if( atomic_exchange( &fs_ram_building, 1 ))
+	{
+		free( rc ); // one build at a time; the running one will be dropped if stale
+		return;
+	}
+
+	rc->search.type = SEARCHPATH_PLAIN; // so disk-path queries give the real file
+	Q_strncpy( rc->search.filename, root, sizeof( rc->search.filename ));
+	rc->search.flags = rc->root_flags;
+	rc->search.ramcache = rc;
+	rc->search.pfnPrintInfo = RAM_PrintInfo;
+	rc->search.pfnClose = RAM_Close;
+	rc->search.pfnOpenFile = RAM_OpenFile;
+	rc->search.pfnFileTime = RAM_FileTime;
+	rc->search.pfnFindFile = RAM_FindFileCallback;
+	rc->search.pfnSearch = RAM_Search;
+	rc->search.pfnLoadFile = RAM_LoadFile;
+
+	rc->next_retired = fs_ram_retired;
+	fs_ram_retired = rc;
+
+	job = malloc( sizeof( *job ));
+	job->rc = rc;
+	job->generation = atomic_fetch_add( &fs_ram_generation, 1 ) + 1;
+
+	pthread_attr_init( &attr );
+	pthread_attr_setdetachstate( &attr, PTHREAD_CREATE_DETACHED );
+#if XASH_APPLE
+	pthread_attr_set_qos_class_np( &attr, QOS_CLASS_USER_INITIATED, 0 );
+#endif
+	if( pthread_create( &thread, &attr, RAM_BuildThread, job ) != 0 )
+	{
+		atomic_store( &fs_ram_building, 0 );
+		free( job );
+	}
+	pthread_attr_destroy( &attr );
+}
+
+int FS_RamCacheFind( const char *name, uint32_t flags, searchpath_t **search, int *index, char *fixedname, size_t len )
+{
+	ramcache_t *rc = RAM_Current();
+	int i;
+	size_t d;
+
+	fs_iostats.ram_state = rc ? 2 : atomic_load( &fs_ram_building ) ? 1 : 0;
+
+	if( !rc )
+		return -1;
+
+	if( flags && !FBitSet( rc->root_flags, flags ))
+		return -1;
+
+	i = RAM_Lookup( rc, name );
+	if( i >= 0 )
+	{
+		fs_iostats.ram_hits++;
+		*search = &rc->search;
+		if( index ) *index = i;
+		if( fixedname ) Q_strncpy( fixedname, rc->files[i].path, len );
+		return 1;
+	}
+
+	if( rc->negative_root_wads && !Q_strchr( name, '/' ) && !Q_strchr( name, '\\' )
+		&& !Q_stricmp( COM_FileExtension( name ), "wad" )
+		&& Q_strnicmp( name, "tempdecal", 9 ) && Q_strnicmp( name, "pldecal", 7 )) // sprays, written while running
+	{
+		fs_iostats.ram_misses_skipped++;
+		return 0;
+	}
+
+	if( !rc->negative_ok || !RAM_ExtensionCovered( name ))
+		return -1;
+
+	for( d = 0; d < RAM_NUM_NEGATIVE_DIRS; d++ )
+	{
+		size_t n = Q_strlen( ram_negative_dirs[d] );
+
+		if( FBitSet( rc->negative_ok, BIT( d ))
+			&& !Q_strnicmp( name, ram_negative_dirs[d], n )
+			&& ( name[n] == '/' || name[n] == '\\' ))
+		{
+			fs_iostats.ram_misses_skipped++;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+void EXPORT FS_GetIOStats( fs_iostats_t *out );
+void EXPORT FS_GetIOStats( fs_iostats_t *out )
+{
+	*out = fs_iostats;
+}
