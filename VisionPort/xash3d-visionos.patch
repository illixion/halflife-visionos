+static int vklite_surface_vert_count( const msurface_t *s )
+{
+	return ( s->numedges < 3 ) ? 0 : 3 * ( s->numedges - 2 );
+}
+
+static void vklite_emit_surface( model_t *world, msurface_t *surf,
+                                  qboolean qbsp2, float *out )
+{
+	mtexinfo_t *ti = surf->texinfo;
+	texture_t *tex = ti ? ti->texture : NULL;
+	float tw = ( tex && tex->width  ) ? (float)tex->width  : 1.0f;
+	float th = ( tex && tex->height ) ? (float)tex->height : 1.0f;
+
+	int n = surf->numedges;
+	// Resolve each surface vertex position by walking surfedges + edges.
+	float positions[256][3];
+	if( n > 256 ) n = 256; // pathological cap
+	for( int i = 0; i < n; ++i ) {
+		int se = world->surfedges[surf->firstedge + i];
+		int abss = se < 0 ? -se : se;
+		unsigned int vi;
+		if( qbsp2 ) {
+			medge32_t *e = &world->edges32[abss];
+			vi = ( se > 0 ) ? e->v[0] : e->v[1];
+		} else {
+			medge16_t *e = &world->edges16[abss];
+			vi = ( se > 0 ) ? e->v[0] : e->v[1];
+		}
+		if( (int)vi >= world->numvertexes ) { vi = 0; }
+		positions[i][0] = world->vertexes[vi].position[0];
+		positions[i][1] = world->vertexes[vi].position[1];
+		positions[i][2] = world->vertexes[vi].position[2];
+	}
+
+	float *w = out;
+	for( int i = 1; i <= n - 2; ++i ) {
+		int idx[3] = { 0, i, i + 1 };
+		for( int k = 0; k < 3; ++k ) {
+			int vi = idx[k];
+			float *p = positions[vi];
+			float s = p[0]*ti->vecs[0][0] + p[1]*ti->vecs[0][1] +
+			          p[2]*ti->vecs[0][2] + ti->vecs[0][3];
+			float t = p[0]*ti->vecs[1][0] + p[1]*ti->vecs[1][1] +
+			          p[2]*ti->vecs[1][2] + ti->vecs[1][3];
+			*w++ = p[0]; *w++ = p[1]; *w++ = p[2];
+			*w++ = s / tw;
+			*w++ = t / th;
+		}
+	}
+}
