+// Convert engine rgbdata_t to a tightly-packed RGBA8 buffer. Returns NULL on
+// unsupported format. Caller owns the returned buffer (Mem_Free... we use plain
+// malloc here since engine helpers aren't available without gEngfuncs.memAlloc).
+static byte *vklite_rgbdata_to_rgba8( rgbdata_t *pic, int *out_w, int *out_h )
+{
+	if( !pic || !pic->buffer ) return NULL;
+	int w = pic->width, h = pic->height;
+	*out_w = w; *out_h = h;
+	size_t px = (size_t)w * (size_t)h;
+	byte *out = (byte *)malloc( px * 4 );
+	if( !out ) return NULL;
