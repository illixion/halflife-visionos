+// Lambda VisionPro split: extract Host_Main's init body and per-frame step
+// into Host_DoInit / Host_DoFrame so the visionOS app can drive the engine
+// from CompositorServices instead of owning main().
+static double s_lambda_oldtime;
+
+int EXPORT Host_DoInit( int argc, char **argv, const char *progname, int bChangeGame, pfnChangeGame pChangeGame );
+int EXPORT Host_DoFrame( void );
+
 int EXPORT Host_Main( int argc, char **argv, const char *progname, int bChangeGame, pfnChangeGame pChangeGame )
 {
-	static double oldtime;
+	int rc = Host_DoInit( argc, argv, progname, bChangeGame, pChangeGame );
+	if( rc != 0 )
+		return rc;
+
+	while( host.status != HOST_CRASHED )
+		Host_DoFrame();
+
+	return 0;
+}
+
+int EXPORT Host_DoFrame( void )
+{
+	double newtime = Platform_DoubleTime();
+	COM_Frame( newtime - s_lambda_oldtime );
+	s_lambda_oldtime = newtime;
+	return host.status == HOST_CRASHED ? -1 : 0;
+}
