+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+*/
+
+/*
+Every file lookup through the plain-directory search paths costs system
+calls: a stat per path component and per search path tried, a full
+directory listing whenever a name is missing from a directory's cached
+listing, then open, stat, lseek, read and close. On a desktop that is
+microseconds; inside the visionOS sandbox it is what makes a level
+change 3-8x slower than the same load on a Mac, while the CPU-bound
+steps run faster there.
+
+So once the search paths are mounted, a background thread reads the
+game assets under <rodir>/<game>/ into memory: models, sprites, sounds,
+maps, WADs, images and text. Lookups for those files are then answered
+from a hash table without touching the disk, and a mirrored file opens
+as a memory-backed file_t. Names that are known to exist nowhere
+(texture and sound variants the engine probes for) are answered too.
+
+Correctness rules:
+ - A file is mirrored only if no search path ahead of the read-only
+   game directory has the same path, so overrides still win.
+ - Absence is only answered for top-level directories that no other
+   plain search path has at all, when no pack or zip is mounted, and only
+   for extensions the mirror covers.
+ - Until the build finishes nothing changes: lookups go to disk.
+ - The read-only tree never changes while running, so a mirror is kept
+   for the life of the process and reused when the paths are rescanned
+   with the same layout. Memory-backed files may point into it at any
+   time, so it is never freed.
+*/
+
+#include "build.h"
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <time.h>
+#include "port.h"
+#include "filesystem.h"
+#include "filesystem_internal.h"
+#include "crtlib.h"
+
+fs_iostats_t fs_iostats;
+
+uint64_t FS_IONow( void )
+{
+#if XASH_APPLE
+	return clock_gettime_nsec_np( CLOCK_UPTIME_RAW );
+#else
+	struct timespec ts;
+	clock_gettime( CLOCK_MONOTONIC, &ts );
+	return (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+#endif
+}
+
+#define RAM_MAX_PATHS 16
+
+typedef struct ramfile_s
+{
+	uint32_t    hash;
+	char        *key;  // lowercase, relative to the game directory
+	char        *path; // as on disk
+	byte        *data;
+	fs_offset_t size;
+	int         mtime;
+} ramfile_t;
+
+// top-level directories that absence can be answered for
+static const char *ram_negative_dirs[] = { "models", "sprites", "sound", "gfx", "events" };
+#define RAM_NUM_NEGATIVE_DIRS ( sizeof( ram_negative_dirs ) / sizeof( ram_negative_dirs[0] ))
+
+typedef struct ramcache_s
+{
+	// layout it was built for
+	char root[MAX_SYSPATH]; // "<rodir>/<game>/"
+	int  root_flags;
+	char shadows[RAM_MAX_PATHS][MAX_SYSPATH]; // plain paths searched before root
+	int  numshadows;
+	char others[RAM_MAX_PATHS][MAX_SYSPATH];  // every other plain path
+	int  numothers;
+	qboolean has_archives;                    // a pak/zip/pk3dir is mounted
+	qboolean read_failed;                     // a covered file couldn't be read
+
+	ramfile_t *files;
+	int       numfiles, maxfiles;
+	int       *slots; // open addressing, -1 empty
+	uint32_t  mask;
+	uint32_t  negative_ok; // bit per ram_negative_dirs entry
+	qboolean  negative_root_wads; // no other path has a WAD at its root
+	uint64_t  bytes;
+	double    build_ms;
+
+	searchpath_t search; // what FS_FindFile hands back for a mirrored file
+
+	struct ramcache_s *next_retired;
+} ramcache_t;
+
+static _Atomic( ramcache_t * ) fs_ram;       // published, ready for lookups
+static atomic_int fs_ram_generation;        // bumped by every start/invalidate
+static atomic_int fs_ram_building;
+static ramcache_t *fs_ram_retired;           // kept alive: files may point in
+
+static const char *ram_extensions[] =
+{
+	"mdl", "spr", "wav", "bsp", "wad", "tga", "bmp", "lmp", "txt", "res", "lst", "sc",
+	"dds", "png", "jpg", "ktx" // none ship with HL; covered so probes for them are answered
+};
+
+// not worth memory, or written by the engine
+static const char *ram_skip_dirs[] =
+{
+	"save", "overviews", "dlls", "cl_dlls", "media", "logos", "graphs"
+};
+
+static uint32_t RAM_Hash( const char *s )
+{
+	uint32_t h = 2166136261u;
+
+	for( ; *s; s++ )
+	{
+		byte c = (byte)*s;
+		if( c >= 'A' && c <= 'Z' ) c += 'a' - 'A';
+		if( c == '\\' ) c = '/';
+		h = ( h ^ c ) * 16777619u;
+	}
+	return h;
+}
+
+static qboolean RAM_KeyEquals( const char *key, const char *name )
+{
+	for( ; *key && *name; key++, name++ )
+	{
+		byte c = (byte)*name;
+		if( c >= 'A' && c <= 'Z' ) c += 'a' - 'A';
+		if( c == '\\' ) c = '/';
+		if( (byte)*key != c )
+			return false;
+	}
+	return *key == *name;
+}
+
+static qboolean RAM_ExtensionCovered( const char *name )
+{
+	const char *ext = COM_FileExtension( name );
+	size_t i;
+
+	for( i = 0; i < ARRAYSIZE( ram_extensions ); i++ )
+	{
+		if( !Q_stricmp( ext, ram_extensions[i] ))
+			return true;
+	}
+	return false;
+}
+
+static qboolean RAM_SkipDir( const char *name )
+{
+	size_t i;
+
+	for( i = 0; i < ARRAYSIZE( ram_skip_dirs ); i++ )
+	{
+		if( !Q_stricmp( name, ram_skip_dirs[i] ))
+			return true;
+	}
+	return false;
+}
+
+static qboolean RAM_PathExists( const char *base, const char *rel )
+{
+	char path[MAX_SYSPATH * 2];
+	struct stat st;
+
+	Q_snprintf( path, sizeof( path ), "%s%s", base, rel );
+	return stat( path, &st ) == 0;
+}
+
+static qboolean RAM_RootHasWad( const char *base )
+{
+	struct dirent *entry;
+	qboolean found = false;
+	DIR *dir = opendir( base );
+
+	if( !dir )
+		return false;
+	while( !found && ( entry = readdir( dir )))
+		found = !Q_stricmp( COM_FileExtension( entry->d_name ), "wad" );
+	closedir( dir );
+	return found;
+}
+
+static void RAM_AddFile( ramcache_t *rc, const char *rel, const char *full )
+{
+	struct stat st;
+	ramfile_t *f;
+	byte *data;
+	ssize_t got;
+	fs_offset_t done = 0;
+	int fd, i;
+
+	for( i = 0; i < rc->numshadows; i++ )
+	{
+		if( RAM_PathExists( rc->shadows[i], rel ))
+			return; // an override is searched first; leave it to the disk
+	}
+
+	// from here on, a file left out would be wrongly reported absent
+	fd = open( full, O_RDONLY );
+	if( fd < 0 )
+	{
+		rc->read_failed = true;
+		return;
+	}
+
+	if( fstat( fd, &st ) < 0 || !S_ISREG( st.st_mode ))
+	{
+		rc->read_failed = true;
+		close( fd );
+		return;
+	}
+
+	data = malloc( st.st_size + 1 );
+	if( !data )
+	{
+		rc->read_failed = true;
+		close( fd );
+		return;
+	}
+
+	while( done < st.st_size && ( got = read( fd, data + done, st.st_size - done )) > 0 )
+		done += got;
+	close( fd );
+
+	if( done != st.st_size )
+	{
+		rc->read_failed = true;
+		free( data );
+		return;
+	}
+	data[done] = 0;
+
+	if( rc->numfiles == rc->maxfiles )
+	{
+		rc->maxfiles = rc->maxfiles ? rc->maxfiles * 2 : 4096;
+		rc->files = realloc( rc->files, sizeof( *rc->files ) * rc->maxfiles );
+	}
+
+	f = &rc->files[rc->numfiles++];
+	f->path = strdup( rel );
+	f->key = strdup( rel );
+	Q_strnlwr( rel, f->key, Q_strlen( rel ) + 1 );
+	f->hash = RAM_Hash( f->key );
+	f->data = data;
+	f->size = done;
+	f->mtime = (int)st.st_mtime;
+	rc->bytes += done;
+}
+
+static void RAM_Walk( ramcache_t *rc, const char *rel )
+{
+	char full[MAX_SYSPATH * 2], child[MAX_SYSPATH];
+	struct dirent *entry;
+	DIR *dir;
+
+	Q_snprintf( full, sizeof( full ), "%s%s", rc->root, rel );
+	dir = opendir( full );
+	if( !dir )
+		return;
+
+	while(( entry = readdir( dir )))
+	{
+		qboolean is_dir;
+
+		if( entry->d_name[0] == '.' )
+			continue;
+
+		Q_snprintf( child, sizeof( child ), "%s%s", rel, entry->d_name );
+
+#if HAVE_DIRENT_D_TYPE
+		if( entry->d_type == DT_DIR )
+			is_dir = true;
+		else if( entry->d_type == DT_REG )
+			is_dir = false;
+		else
+#endif
+		{
+			struct stat st;
+			Q_snprintf( full, sizeof( full ), "%s%s", rc->root, child );
+			if( stat( full, &st ) < 0 )
+				continue;
+			is_dir = S_ISDIR( st.st_mode );
+		}
+
+		if( is_dir )
+		{
+			if( RAM_SkipDir( entry->d_name ))
+				continue;
+			Q_strncat( child, "/", sizeof( child ));
+			RAM_Walk( rc, child );
+		}
+		else if( RAM_ExtensionCovered( entry->d_name ))
+		{
+			Q_snprintf( full, sizeof( full ), "%s%s", rc->root, child );
+			RAM_AddFile( rc, child, full );
+		}
+	}
+
+	closedir( dir );
+}
+
+static void RAM_BuildTable( ramcache_t *rc )
+{
+	uint32_t size = 1;
+	int i;
+
+	while( size < (uint32_t)rc->numfiles * 2 )
+		size <<= 1;
+	rc->mask = size - 1;
+	rc->slots = malloc( sizeof( *rc->slots ) * size );
+	memset( rc->slots, 0xff, sizeof( *rc->slots ) * size );
+
+	for( i = 0; i < rc->numfiles; i++ )
+	{
+		uint32_t slot = rc->files[i].hash & rc->mask;
+
+		while( rc->slots[slot] >= 0 )
+			slot = ( slot + 1 ) & rc->mask;
+		rc->slots[slot] = i;
+	}
+}
+
+static int RAM_Lookup( const ramcache_t *rc, const char *name )
+{
+	uint32_t slot = RAM_Hash( name ) & rc->mask;
+
+	for( ; rc->slots[slot] >= 0; slot = ( slot + 1 ) & rc->mask )
+	{
+		const ramfile_t *f = &rc->files[rc->slots[slot]];
+		if( RAM_KeyEquals( f->key, name ))
+			return rc->slots[slot];
+	}
+	return -1;
+}
+
+static ramcache_t *RAM_Current( void )
+{
+	return atomic_load_explicit( &fs_ram, memory_order_acquire );
+}
+
+/*
+============
+searchpath callbacks for mirrored files
+============
+*/
+static file_t *RAM_OpenFile( searchpath_t *search, const char *filename, const char *mode, int pack_ind )
+{
+	const ramcache_t *rc = search->ramcache;
+	const ramfile_t *f;
+	file_t *file;
+
+	if( pack_ind < 0 || pack_ind >= rc->numfiles )
+		return NULL;
+	f = &rc->files[pack_ind];
+
+	file = (file_t *)Mem_Calloc( fs_mempool, sizeof( *file ));
+	file->handle = -1;
+	file->ungetc = EOF;
+	file->filetime = f->mtime;
+	file->searchpath = search;
+	file->real_length = f->size;
+	file->mem = f->data;
+	return file;
+}
+
+static byte *RAM_LoadFile( searchpath_t *search, const char *path, int pack_ind, fs_offset_t *filesizeptr, void *( *pfnAlloc )( size_t ), void ( *pfnFree )( void * ))
+{
+	const ramcache_t *rc = search->ramcache;
+	const ramfile_t *f;
+	byte *buf;
+
+	if( pack_ind < 0 || pack_ind >= rc->numfiles )
+		return NULL;
+	f = &rc->files[pack_ind];
+
+	buf = pfnAlloc( f->size + 1 );
+	if( !buf )
+		return NULL;
+	memcpy( buf, f->data, f->size + 1 ); // mirrored data carries the terminating zero
+	if( filesizeptr )
+		*filesizeptr = f->size;
+	return buf;
+}
+
+static int RAM_FileTime( searchpath_t *search, const char *filename )
+{
+	const ramcache_t *rc = search->ramcache;
+	int i = RAM_Lookup( rc, filename );
+	return i >= 0 ? rc->files[i].mtime : -1;
+}
+
+static int RAM_FindFileCallback( searchpath_t *search, const char *path, char *fixedname, size_t len )
+{
+	const ramcache_t *rc = search->ramcache;
+	int i = RAM_Lookup( rc, path );
+
+	if( i >= 0 && fixedname )
+		Q_strncpy( fixedname, rc->files[i].path, len );
+	return i;
+}
