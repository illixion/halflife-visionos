+	for( int r = 0; r < 4; ++r ) {
+		float s = 0.0f;
+		for( int k = 0; k < 4; ++k )
+			s += A[k * 4 + r] * B[c * 4 + k];
+		out[c * 4 + r] = s;
+	}
