+// Asymmetric (off-axis) frustum from per-side view-space tangents, for
+// stereo eye views whose projection is not centered on the view axis.
+// Tangent magnitudes: how far the frustum extends past forward on each side.
+static void GL_FrustumSetSidePlane( gl_frustum_t *out, int side, float tangent, const vec3_t axis, float axisSign )
+{
+	float	inv = 1.0f / sqrtf( 1.0f + tangent * tangent );
+	float	xs = tangent * inv; // sin of the half-angle
+	float	xc = inv;           // cos of the half-angle
+	vec3_t	normal;
+
+	VectorMAM( xs, RI.cull_vforward, xc * axisSign, axis, normal );
+	GL_FrustumSetPlane( out, side, normal, DotProduct( RI.cullorigin, normal ));
+}
