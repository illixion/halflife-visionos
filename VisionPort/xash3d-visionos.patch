+		Sys_Error( "%s: filesystem static link API version mismatch\n", __func__ );
+		return false;
+	}
+	fs_pfnCreateInterface = (pfnCreateInterface_t)CreateInterface;
+	fs_hInstance = (void *)0x1; // sentinel; never dlclosed
+	return true;
+}
+#else
