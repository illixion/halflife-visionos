-	xc.add_option('--ios-simulator', action='store_true', dest='IOSSIM', default=False, 
+	xc.add_option('--ios-simulator', action='store_true', dest='IOSSIM', default=False,
 		help='enable building for iOS Simulator [default: %(default)s]')
+	xc.add_option('--xros', action='store_true', dest='XROS', default=False,
+		help='enable building for visionOS [default: %(default)s]')
+	xc.add_option('--xros-simulator', action='store_true', dest='XROSSIM', default=False,
+		help='enable building for visionOS Simulator [default: %(default)s]')
 
 def configure(conf):
 	if 'CROSS_COMPILE' in conf.environ:
@@ -799,12 +830,27 @@ def configure(conf):
 
 		conf.environ['CC'] = ios.cc()
 		conf.environ['CXX'] = ios.cxx()
