+	switch( pic->type )
+	{
+	case PF_RGBA_32:
+		memcpy( out, pic->buffer, px * 4 );
+		break;
+	case PF_RGB_24:
+		for( size_t i = 0; i < px; ++i ) {
+			out[i*4+0] = pic->buffer[i*3+0];
+			out[i*4+1] = pic->buffer[i*3+1];
+			out[i*4+2] = pic->buffer[i*3+2];
+			out[i*4+3] = 255;
+		}
+		break;
+	case PF_INDEXED_24:
+	case PF_INDEXED_32:
+		if( !pic->palette ) { free( out ); return NULL; }
+		for( size_t i = 0; i < px; ++i ) {
