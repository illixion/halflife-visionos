+	float a = zf / ( zf - zn );
+	float b = -( zn * zf ) / ( zf - zn );
+	float P[16] = {
+		fx,  0,   0,   0,
+		0,   fy,  0,   0,
+		0,   0,   a,   1,
+		0,   0,   b,   0
+	};
+
+	// mvp = P * V  (column-major mul).
+	for( int c = 0; c < 4; ++c )
+	for( int r = 0; r < 4; ++r ) {
+		float s = 0.0f;
+		for( int k = 0; k < 4; ++k )
+			s += P[k * 4 + r] * V[c * 4 + k];
+		mvp[c * 4 + r] = s;
+	}
