+/*
+Directory listings are memoized. The case-insensitive lookup relists a
+directory whenever a name is missing from it, and image lookups search
+"<name>.*" in the root of every search path, so one level load lists the
+same few directories hundreds of times; in the visionOS sandbox each
+listing is expensive. Anything the filesystem writes, renames, deletes or
+creates drops the memo, and entries expire after a couple of seconds for
+changes made behind its back.
+*/
+#define FS_LSMEMO_SIZE 64
+#define FS_LSMEMO_TTL_NS 2000000000ull
+
+typedef struct
+{
+	char         path[MAX_SYSPATH];
+	qboolean     dirs_only;
+	stringlist_t list;
+	uint64_t     time;
+	uint32_t     generation;
+} fs_lsmemo_t;
+
+static fs_lsmemo_t fs_lsmemo[FS_LSMEMO_SIZE];
+static int fs_lsmemo_next;
+static uint32_t fs_lsmemo_generation = 1;
+
+static void FS_DirectoriesChanged( void )
+{
+	fs_lsmemo_generation++;
+}
+
+static void listdirectory_( stringlist_t *list, const char *path, qboolean dirs_only );
+
 void listdirectory( stringlist_t *list, const char *path, qboolean dirs_only )
+{
+	uint64_t now = FS_IONow();
+	fs_lsmemo_t *m;
+	int i;
+
+	for( i = 0; i < FS_LSMEMO_SIZE; i++ )
+	{
+		m = &fs_lsmemo[i];
+		if( m->generation == fs_lsmemo_generation && m->dirs_only == dirs_only
+			&& now - m->time < FS_LSMEMO_TTL_NS && !Q_strcmp( m->path, path ))
+		{
+			int j;
+			for( j = 0; j < m->list.numstrings; j++ )
+				stringlistappend( list, m->list.strings[j] );
+			return;
+		}
+	}
+
+	m = &fs_lsmemo[fs_lsmemo_next];
+	fs_lsmemo_next = ( fs_lsmemo_next + 1 ) % FS_LSMEMO_SIZE;
+
+	stringlistfreecontents( &m->list );
+	stringlistinit( &m->list );
+	listdirectory_( &m->list, path, dirs_only );
+	Q_strncpy( m->path, path, sizeof( m->path ));
+	m->dirs_only = dirs_only;
+	m->time = now;
+	m->generation = fs_lsmemo_generation;
+
+	for( i = 0; i < m->list.numstrings; i++ )
+		stringlistappend( list, m->list.strings[i] );
+}
