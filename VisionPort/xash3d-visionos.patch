+// Build column-major MVP for ref_viewpass_t rvp. HL world convention:
+// X forward, Y left, Z up. We map to a Vulkan camera that looks down its
+// +Z, with +X right and +Y down (default NDC). Near/far chosen large
+// enough to cover any HL map.
+static void vklite_build_mvp( const struct ref_viewpass_s *rvp, float mvp[16] )
+{
+	vec3_t fwd, right, up;
+	AngleVectors( rvp->viewangles, fwd, right, up );
+
+	// Camera basis in world space:
+	//   camRight  =  right  (engine right = world -Y)
+	//   camDown   = -up     (Vulkan +Y points down)
+	//   camFwd    =  fwd
+	float cr[3] = { right[0], right[1], right[2] };
+	float cd[3] = { -up[0],   -up[1],   -up[2] };
+	float cf[3] = { fwd[0],   fwd[1],   fwd[2] };
+	const float *o = rvp->vieworigin;
+
+	// View matrix (world -> camera). Column-major.
+	float V[16] = {
+		cr[0], cd[0], cf[0], 0.0f,
+		cr[1], cd[1], cf[1], 0.0f,
+		cr[2], cd[2], cf[2], 0.0f,
+		-(cr[0]*o[0] + cr[1]*o[1] + cr[2]*o[2]),
+		-(cd[0]*o[0] + cd[1]*o[1] + cd[2]*o[2]),
+		-(cf[0]*o[0] + cf[1]*o[1] + cf[2]*o[2]),
+		1.0f
+	};
