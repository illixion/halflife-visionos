+/*
+===============
+R_AddFlashlightCone
+
+LambdaVision: the local flashlight as a spot. Stock splats a radial disc
+around the impact point, the same shape whatever angle the beam meets the
+surface at. This lights each lightmap sample by the angle it makes with the
+beam instead: the sample is projected onto the plane through the impact
+square to the beam (gnomonic), so a surface facing the beam gets exactly
+a disc the size of the stock one, and a surface met at a slant gets it stretched into the
+ellipse a real torch throws. Brightness keeps the stock linear falloff and
+drops with the square of distance past the impact, never above stock, so
+the flashlight lights no more than it did.
+===============
+*/
+static void R_AddFlashlightCone( const msurface_t *surf, const dlight_t *dl, const vec3_t center, const vec3_t impact,
+	float sl, float tl, int smax, int tmax, float sample_size )
+{
+	const mextrasurf_t *info = surf->info;
+	const float rad = dl->radius;
+	const float lim = rad - dl->minlight;
+	const float reach = rad * VR_FLASHLIGHT_REACH;
+	const float d = Q_max( gpGlobals->vr_flashlight_dist, 1.0f );
+	vec3_t src, dir, n, a, b, tmp;
+	float det;
+	int s, t;
+
+	if( lim <= 0.0f )
+		return;
+
+	// beam into the surface's model space (brush entities are drawn moved)
+	if( !tr.modelviewIdentity )
+	{
+		Matrix4x4_VectorITransform( RI.objectMatrix, gpGlobals->vr_flashlight_origin, src );
+		Matrix4x4_VectorIRotate( RI.objectMatrix, gpGlobals->vr_flashlight_dir, dir );
+	}
+	else
+	{
+		VectorCopy( gpGlobals->vr_flashlight_origin, src );
+		VectorCopy( gpGlobals->vr_flashlight_dir, dir );
+	}
+
+	// only the side of the surface that faces the torch
+	VectorCopy( surf->plane->normal, n );
+	if( FBitSet( surf->flags, SURF_PLANEBACK ))
+		VectorNegate( n, n );
+	VectorSubtract( src, impact, tmp );
+	if( DotProduct( tmp, n ) <= 0.0f )
+		return;
+
+	// World offset of a lightmap coordinate step: invert [L0; L1; N] once.
+	// Exact for any texture projection, so no luxel-scale assumptions.
+	CrossProduct( info->lmvecs[1], n, a );
+	CrossProduct( n, info->lmvecs[0], b );
+	det = DotProduct( info->lmvecs[0], a );
+	if( fabs( det ) < 1e-6f )
+		return;
+	VectorScale( a, 1.0f / det, a );
+	VectorScale( b, 1.0f / det, b );
+
+	for( t = 0; t < tmax; t++ )
+	{
+		const float dt = sample_size * t - tl;
+
+		for( s = 0; s < smax; s++ )
+		{
+			const float ds = sample_size * s - sl;
+			vec3_t p, v;
+			float along, len2, perp, r, amount;
+			uint *bl;
+
+			p[0] = impact[0] + a[0] * ds + b[0] * dt;
+			p[1] = impact[1] + a[1] * ds + b[1] * dt;
+			p[2] = impact[2] + a[2] * ds + b[2] * dt;
