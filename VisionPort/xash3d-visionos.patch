 		conf.env.CFLAGS += ios.cflags()
 		conf.env.CXXFLAGS += ios.cflags()
 		conf.env.LINKFLAGS += ios.linkflags()
 		conf.env.IOS = 1
 
+	elif conf.options.XROS or conf.options.XROSSIM:
+		issim = True if conf.options.XROSSIM else False
+
+		conf.xros = xros = visionOS(conf, issim)
+
+		conf.environ['CC'] = xros.cc()
+		conf.environ['CXX'] = xros.cxx()
+
+		conf.env.CFLAGS += xros.cflags()
+		conf.env.CXXFLAGS += xros.cflags()
+		conf.env.LINKFLAGS += xros.linkflags()
+		conf.env.XROS = 1
+		# Don't set IOS=1 — that pulls in the SDL2 UIKit launcher.
