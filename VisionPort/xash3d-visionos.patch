--- a/scripts/waifulib/xcompile.py
+++ b/scripts/waifulib/xcompile.py
@@ -75,6 +75,33 @@ class iOS:
 	def cxx(self):
 		return 'clang++'
 
+class visionOS:
+	ctx = None
+	sdkpath = None
+	target = None
+
+	def __init__(self, ctx, issim):
+		self.ctx = ctx
+		sdk = 'xrsimulator' if issim else 'xros'
+		self.sdkpath = ctx.cmd_and_log('xcrun --show-sdk-path --sdk %s' % sdk).strip()
+		# clang takes the OS version as part of the triple for visionOS
+		self.target = '--target=arm64-apple-xros2.0'
+		if issim: self.target += '-simulator'
+
+	def cflags(self, cxx = False):
+		cflags = [ '-isysroot' + self.sdkpath, self.target ]
+		return cflags
+
+	def linkflags(self):
+		linkflags = [ '-isysroot' + self.sdkpath, self.target ]
+		return linkflags
+
+	def cc(self):
+		return 'clang'
+
+	def cxx(self):
+		return 'clang++'
+
 # This class does support ONLY r10e and r19c/r20 NDK
 class Android:
 	ctx            = None # waf context
@@ -644,10 +671,14 @@ def options(opt):
 		help='enable building for Emscripten')
 	xc.add_option('--psp', action='store', dest='PSP_OPTS', default=None,
 		help='enable building for PlayStation Portable, format: --psp=<module type>,<fw version>,<render type>, example: --psp=prx,660,HW')
