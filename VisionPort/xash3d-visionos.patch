+{
+	Con_Printf( "visionOS: CompositorServices owns the present (no window)\n" );
+}
+
+void VID_RestoreScreenResolution( window_mode_t window_mode )
+{
+	(void)window_mode;
+}
+
+void VID_SaveWindowSize( int width, int height, qboolean maximized )
+{
+	(void)width; (void)height; (void)maximized;
+}
+
+rserr_t R_ChangeDisplaySettings( int width, int height, window_mode_t window_mode )
+{
+	(void)window_mode;
+	refState.width  = width;
+	refState.height = height;
+	return rserr_ok;
+}
+
+void *GL_GetProcAddress( const char *name )
+{
+	(void)name;
+	return NULL;
+}
+
+int GL_SetAttribute( int attr, int val )
+{
+	(void)attr; (void)val;
+	return 0;
+}
+
+int GL_GetAttribute( int attr, int *val )
+{
+	(void)attr;
+	if( val ) *val = 0;
+	return 0;
+}
