@@ -2679,6 +2689,32 @@ static void CL_UpdateFlashlight( cl_entity_t *ent )
 	}
 
 	VectorAdd( ent->origin, view_ofs, vecSrc );
+
+	if( ent->index == ( cl.playernum + 1 ) && cl_vr_flashlight[0] > 0.0f )
+	{
+		extern int   cl_stereo_view_angles_override_active;
+		extern float cl_stereo_view_angles_override[3]; // abs pitch, delta yaw, abs roll
+		const float *o = cl_vr_flashlight;
+		const float viewYaw = cl.viewangles[YAW] + ( cl_stereo_view_angles_override_active ? cl_stereo_view_angles_override[1] : 0.0f );
+		const float viewPitch = cl_stereo_view_angles_override_active ? cl_stereo_view_angles_override[0] : cl.viewangles[PITCH];
+		const float y = DEG2RAD( viewYaw ), c = cosf( y ), s = sinf( y );
+		vec3_t beam, source;
+
+		beam[PITCH] = viewPitch + o[4];
+		beam[YAW] = viewYaw + o[5];
+		beam[ROLL] = 0.0f;
+		AngleVectors( beam, forward, NULL, NULL );
+
+		source[0] = vecSrc[0] + c * o[1] - s * o[2];
+		source[1] = vecSrc[1] + s * o[1] + c * o[2];
+		source[2] = vecSrc[2] + o[3];
+
+		// same rule as the shot: a torch pushed through a wall stays at the eye
+		trace = CL_TraceLine( vecSrc, source, PM_STUDIO_BOX );
+		if( trace.fraction >= 1.0f && !trace.startsolid && !trace.allsolid )
+			VectorCopy( source, vecSrc );
+	}
+
 	VectorMA( vecSrc, FLASHLIGHT_DISTANCE, forward, vecEnd );
 
 	trace = CL_TraceLine( vecSrc, vecEnd, PM_STUDIO_BOX );
