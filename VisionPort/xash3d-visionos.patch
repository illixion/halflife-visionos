+/*
+===============
+R_DumpViewForVR
+
+Desktop-only tool for the visionOS app's snapshot reprojection: writes the
+3D view just drawn — RGBA8 colour, float window depth (both bottom-up rows,
+as GL reads them) and the GL projection and world-view matrices
+(column-major) — to vrdump.bin, so a Mac harness can re-render it from other
+head poses. The value of r_vrdump is the file's index (vrdump<N>.bin).
+===============
+*/
+static void R_DumpViewForVR( void )
+{
+	int *vp = RI.rvp.viewport, w, h, n = (int)r_vrdump.value;
+	float proj[16], view[16];
+	byte *rgba;
+	float *depth;
+	char name[64];
+	FILE *f;
+
+	gEngfuncs.Cvar_SetValue( "r_vrdump", 0 );
+	w = vp[2]; h = vp[3];
+	rgba = malloc( (size_t)w * h * 4 );
+	depth = malloc( (size_t)w * h * sizeof( float ));
+	pglReadPixels( vp[0], vp[1], w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba );
+	pglReadPixels( vp[0], vp[1], w, h, GL_DEPTH_COMPONENT, GL_FLOAT, depth );
+	Matrix4x4_ToArrayFloatGL( RI.projectionMatrix, proj );
+	Matrix4x4_ToArrayFloatGL( RI.worldviewMatrix, view );
+
+	Q_snprintf( name, sizeof( name ), "vrdump%d.bin", n );
+	f = fopen( name, "wb" );
+	if( f )
+	{
+		int header[4] = { 0x44525656 /* VVRD */, 1, w, h };
+		fwrite( header, sizeof( header ), 1, f );
+		fwrite( proj, sizeof( proj ), 1, f );
+		fwrite( view, sizeof( view ), 1, f );
+		fwrite( RI.rvp.vieworigin, sizeof( float ), 3, f );
+		fwrite( RI.rvp.viewangles, sizeof( float ), 3, f );
+		fwrite( rgba, (size_t)w * h * 4, 1, f );
+		fwrite( depth, (size_t)w * h * sizeof( float ), 1, f );
+		fclose( f );
+		gEngfuncs.Con_Printf( "wrote %s (%dx%d)\n", name, w, h );
+	}
+	free( rgba );
+	free( depth );
