index d4628f3..295b93d 100644
--- a/engine/client/cl_view.c
+++ b/engine/client/cl_view.c
@@ -22,6 +22,30 @@ GNU General Public License for more details.
 #include "input.h" // touch
 #include "platform/platform.h" // GL_UpdateSwapInterval
 
+// Stereo eye offset (signed half-IPD along view-right). The visionOS bridge
+// flips its sign between the two per-eye render passes; mono callers leave
+// it at 0. Public-by-extern; declared inline at the use site in V_RenderView.
+float cl_stereo_eye_offset = 0.0f;
+int   cl_stereo_view_angles_override_active = 0;
+float cl_stereo_view_angles_override[3] = { 0.0f, 0.0f, 0.0f }; // pitch, yaw, roll
+float cl_stereo_view_origin_offset[3] = { 0.0f, 0.0f, 0.0f }; // head translation, baseline-yaw frame
+
+// VR: when set, CL_ApplyAddAngle drops the server's incremental yaw
+// rotation (svc_addangle, sent while riding rotating pushers such as
+// func_tracktrain). A headset view must keep its compass heading fixed
+// while the vehicle turns; svc_setangle (teleports, spawns) still applies.
+int   cl_stereo_no_addangle = 0;
+
+// VR snap turn: rotate the player's actual input yaw so the movement
+// basis and the rendered view (game yaw + head delta) turn together.
+// Rotating only the platform-side head baseline turns the picture but
+// leaves cl.viewangles behind, desyncing +forward/+moveleft from what
+// the user sees.
+void CL_StereoAddViewYaw( float deg )
+{
+	cl.viewangles[YAW] += deg;
+}
+
 /*
 ===============
 V_CalcViewRect
@@ -419,6 +443,51 @@ void V_RenderView( void )
 			ref.dllFuncs.R_ClearScreen();
 		}
 
+		// Head-tracked view angles. Pitch and roll REPLACE the game's
+		// values with the headset's absolute orientation, decomposed in
+		// the engine's own Euler order (yaw·pitch·roll) — mixing game
+		// pitch with head pitch, or composing per-axis deltas, makes
+		// compound head moves (yaw then pitch) pick up spurious roll.
+		// Yaw alone is a DELTA added to the game's yaw: yaw composes on
+		// the left in this Euler order, so spawn orientation and
+		// keyboard/mouse turning still work and the result is exact.
+		// Set externally by the visionOS bridge each frame. Order
+		// matters: apply viewangles FIRST so the IPD shift below
+		// computes view-right from the final (head-rotated) view.
+		extern int   cl_stereo_view_angles_override_active;
+		extern float cl_stereo_view_angles_override[3]; // abs pitch, delta yaw, abs roll
+		extern float cl_stereo_view_origin_offset[3];   // head translation, baseline-yaw frame
+		if( cl_stereo_view_angles_override_active )
+		{
+			// Positional tracking: the headset's translation since baseline,
+			// expressed in the baseline-forward frame (xash units), rotated
+			// into the world by the game's yaw so physical movement maps to
+			// the direction the player entity faces. Must use the yaw BEFORE
+			// the head delta below — the head's own yaw is already part of
+			// the room-space measurement.
+			float yawrad = DEG2RAD( rvp.viewangles[1] );
+			float ys = sinf( yawrad ), yc = cosf( yawrad );
+			rvp.vieworigin[0] += yc * cl_stereo_view_origin_offset[0] - ys * cl_stereo_view_origin_offset[1];
+			rvp.vieworigin[1] += ys * cl_stereo_view_origin_offset[0] + yc * cl_stereo_view_origin_offset[1];
+			rvp.vieworigin[2] += cl_stereo_view_origin_offset[2];
+
+			rvp.viewangles[0]  = cl_stereo_view_angles_override[0];
+			rvp.viewangles[1] += cl_stereo_view_angles_override[1];
+			rvp.viewangles[2]  = cl_stereo_view_angles_override[2];
+		}
+
+		// Stereo: shift the camera along the view-right axis by the
+		// caller-supplied half-IPD. Set externally by the visionOS
+		// bridge between the two per-eye render passes; defaults to 0
+		// (no shift) when running mono.
+		extern float cl_stereo_eye_offset;
+		if( cl_stereo_eye_offset != 0.0f )
+		{
+			vec3_t fwd, right, up;
+			AngleVectors( rvp.viewangles, fwd, right, up );
+			VectorMA( rvp.vieworigin, cl_stereo_eye_offset, right, rvp.vieworigin );
+		}
+
 		GL_RenderFrame( &rvp );
 		S_UpdateFrame( &rvp );
 		viewnum++;
