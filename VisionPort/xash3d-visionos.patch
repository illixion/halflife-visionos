+		// Stereo: shift the camera along the view-right axis by the
+		// caller-supplied half-IPD. Set externally by the visionOS
+		// bridge between the two per-eye render passes; defaults to 0
+		// (no shift) when running mono.
+		extern float cl_stereo_eye_offset;
+		if( cl_stereo_eye_offset != 0.0f )
+		{
+			vec3_t fwd, right, up;
+			AngleVectors( rvp.viewangles, fwd, right, up );
+			VectorMA( rvp.vieworigin, cl_stereo_eye_offset, right, rvp.vieworigin );
