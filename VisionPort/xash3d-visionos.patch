+/*
+vid_visionos.c — minimal stub platform layer for visionOS / Apple Vision Pro
+
+CompositorServices owns the per-eye drawables; the host app's bridge feeds
+input/audio. The renderer (eventually ref_vk_lite) talks to MoltenVK directly.
+This file exists only to satisfy the engine's platform contract for the few
+entry points platform.h doesn't already inline-stub for non-SDL builds.
+*/
+
+#include "platform/platform.h"
+#include "client.h"
+
+#if XASH_VIDEO == VIDEO_VISIONOS
+
+// ---- Video / VID -----------------------------------------------------------
+
+qboolean R_Init_Video( ref_graphic_apis_t type )
+{
+	(void)type;
+	host.renderinfo_changed = false;
+	refState.width  = 1920;
+	refState.height = 1080;
+	return true;
+}
+
+void R_Free_Video( void )
+{
+}
+
