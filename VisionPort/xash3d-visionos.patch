+// Asymmetric (off-axis) frustum from per-side view-space tangents, for
+// stereo eye views whose projection is not centered on the view axis.
+// Tangent magnitudes: how far the frustum extends past forward on each side.
+static void GL_FrustumSetSidePlane( gl_frustum_t *out, int side, float tangent, const vec3_t axis, float axisSign )
+{
+	float	inv = 1.0f / sqrtf( 1.0f + tangent * tangent );
+	float	xs = tangent * inv; // sin of the half-angle
+	float	xc = inv;           // cos of the half-angle
+	vec3_t	normal;
+
+	VectorMAM( xs, RI.cull_vforward, xc * axisSign, axis, normal );
+	GL_FrustumSetPlane( out, side, normal, DotProduct( RI.cullorigin, normal ));
+}
+
+void GL_FrustumInitProjAsym( gl_frustum_t *out, float flZFar, float tanLeft, float tanRight, float tanTop, float tanBottom )
+{
+	vec3_t	farpoint, iforward;
+
+	// each inward-pointing plane normal is sin(a)*forward ± cos(a)*axis;
+	// the plane built with -right bounds the RIGHT edge, +right the LEFT,
+	// -up the TOP, +up the BOTTOM (matching GL_FrustumInitProj's layout).
+	GL_FrustumSetSidePlane( out, FRUSTUM_LEFT, tanRight, RI.cull_vright, -1.0f );
+	GL_FrustumSetSidePlane( out, FRUSTUM_RIGHT, tanLeft, RI.cull_vright, 1.0f );
+	GL_FrustumSetSidePlane( out, FRUSTUM_BOTTOM, tanTop, RI.cull_vup, -1.0f );
+	GL_FrustumSetSidePlane( out, FRUSTUM_TOP, tanBottom, RI.cull_vup, 1.0f );
+
+	// setup far plane
+	VectorNegate( RI.cull_vforward, iforward );
+	VectorMA( RI.cullorigin, flZFar, RI.cull_vforward, farpoint );
+	GL_FrustumSetPlane( out, FRUSTUM_FAR, iforward, DotProduct( iforward, farpoint ));
+}
