+// Build a column-major 4x4 from HL entity origin + angles (no scale).
+// Same yaw/pitch/roll order as Matrix4x4_CreateFromEntity.
+static void vklite_entity_model_matrix( const vec3_t origin, const vec3_t angles,
+                                         float M[16] )
+{
+	float p = angles[0] * (float)M_PI / 180.0f;
+	float y = angles[1] * (float)M_PI / 180.0f;
+	float r = angles[2] * (float)M_PI / 180.0f;
+	float sp = sinf( p ), cp = cosf( p );
+	float sy = sinf( y ), cy = cosf( y );
+	float sr = sinf( r ), cr = cosf( r );
+
+	// Row-major rotation, then write column-major.
+	float R[3][3] = {
+		{ cp*cy,           sr*sp*cy + cr*-sy,  cr*sp*cy + -sr*-sy },
+		{ cp*sy,           sr*sp*sy + cr*cy,   cr*sp*sy + -sr*cy  },
+		{ -sp,             sr*cp,              cr*cp              }
+	};
+	M[ 0] = R[0][0]; M[ 1] = R[1][0]; M[ 2] = R[2][0]; M[ 3] = 0.0f;
