 {
-	static double oldtime;
+	int rc = Host_DoInit( argc, argv, progname, bChangeGame, pChangeGame );
+	if( rc != 0 )
+		return rc;
+
+	while( host.status != HOST_CRASHED )
+		Host_DoFrame();
+
+	return 0;
+}
+
+int EXPORT Host_DoFrame( void )
+{
+	double newtime = Platform_DoubleTime();
+	COM_Frame( newtime - s_lambda_oldtime );
+	s_lambda_oldtime = newtime;
+	return host.status == HOST_CRASHED ? -1 : 0;
+}
