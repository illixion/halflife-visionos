index 0000000..386cf5c
--- /dev/null
+++ b/engine/platform/visionos/vid_visionos.c
@@ -0,0 +1,138 @@
+/*
+vid_visionos.c — minimal stub platform layer for visionOS / Apple Vision Pro
+
+CompositorServices owns the per-eye drawables; the host app's bridge feeds
+input/audio. The renderer (eventually ref_vk_lite) talks to MoltenVK directly.
+This file exists only to satisfy the engine's platform contract for the few
+entry points platform.h doesn't already inline-stub for non-SDL builds.
+*/
+
+#include "platform/platform.h"
+#include "client.h"
+#include "ref_common.h"
+#include <dlfcn.h>
+
+#if XASH_VIDEO == VIDEO_VISIONOS
+
+// ANGLE's EGL is statically linked into the app exec. Declared here to
+// avoid pulling EGL/egl.h (and its system-header dependencies) into the
+// engine's include path.
+extern void *eglGetProcAddress( const char *procname );
+
+// ---- Video / VID -----------------------------------------------------------
+
+qboolean R_Init_Video( ref_graphic_apis_t type )
+{
+	(void)type;
+	host.renderinfo_changed = false;
+	refState.width  = 1024;
+	refState.height = 1024;
+	if( ref.dllFuncs.GL_InitExtensions )
+		ref.dllFuncs.GL_InitExtensions();
+	return true;
+}
+
+void R_Free_Video( void )
+{
+}
+
+qboolean VID_SetMode( void )
+{
+	return true;
+}
+
+void VID_Info_f( void )
+{
+	Con_Printf( "visionOS: CompositorServices owns the present (no window)\n" );
+}
+
+void VID_RestoreScreenResolution( window_mode_t window_mode )
+{
+	(void)window_mode;
+}
+
+void VID_SaveWindowSize( int width, int height, qboolean maximized )
+{
+	(void)width; (void)height; (void)maximized;
+}
+
+rserr_t R_ChangeDisplaySettings( int width, int height, window_mode_t window_mode )
+{
+	(void)window_mode;
+	refState.width  = width;
+	refState.height = height;
+	return rserr_ok;
+}
+
+void *GL_GetProcAddress( const char *name )
+{
+	if( !name ) return NULL;
+	void *fn = eglGetProcAddress( name );
+	if( !fn ) fn = dlsym( RTLD_DEFAULT, name );
+	return fn;
+}
+
+int GL_SetAttribute( int attr, int val )
+{
+	(void)attr; (void)val;
+	return 0;
+}
+
+int GL_GetAttribute( int attr, int *val )
+{
+	(void)attr;
+	if( val ) *val = 0;
+	return 0;
+}
+
+void GL_SwapBuffers( void )
+{
+}
+
+void GL_UpdateSwapInterval( void )
+{
+}
+
+int R_MaxVideoModes( void )
+{
+	return 0;
+}
+
+struct vidmode_s *R_GetVideoMode( int num )
+{
+	(void)num;
+	return NULL;
+}
+
+ref_window_type_t R_GetWindowHandle( void **handle, ref_window_type_t type )
+{
+	(void)type;
+	if( handle ) *handle = NULL;
+	return REF_WINDOW_TYPE_NULL;
+}
+
+qboolean SW_CreateBuffer( int width, int height, uint *stride, uint *bpp, uint *r, uint *g, uint *b )
+{
+	(void)width; (void)height; (void)stride; (void)bpp; (void)r; (void)g; (void)b;
+	return false;
+}
+
+void *SW_LockBuffer( void )
+{
+	return NULL;
+}
+
+void SW_UnlockBuffer( void )
+{
+}
+
+platform_orientation_t Platform_GetDisplayOrientation( void )
+{
+	return ORIENTATION_LANDSCAPE;
+}
+
+void Platform_Minimize_f( void )
+{
+}
+
+#endif // XASH_VIDEO == VIDEO_VISIONOS
