+
+#include "platform/platform.h"
+#include "sound.h"
+
+#include <AudioToolbox/AudioQueue.h>
+
+// AudioQueue pulls fixed-size buffers from its own render thread while the
+// engine mixes into the snd.buffer ring on the GL worker. Same
+// producer/consumer contract as the SDL2 backend: the callback advances
+// snd.samplepos, the mixer paints ahead of it. LOCK-FREE by design: the
+// callback runs on a real-time audio thread that the system can suspend
+// at any moment (session interruptions, headset doffed, app background) —
+// a mutex shared with the mixer would leave the GL worker blocked forever
+// if the callback is suspended while holding it (observed on device).
+// This mirrors real DMA hardware, which the engine's mixer was written
+// for: the consumer streams the ring concurrently with the producer, no
+// lock exists, and a race costs at worst one torn buffer (~23 ms click).
+// samplepos is published with a release store and read with plain aligned
+// loads (atomic on arm64).
+// Small buffers keep output latency (hence pan lag in VR) low. 3×512 @
+// 44100 = ~35 ms of queue depth; the engine tick (~8 ms at 120 fps) refills
+// well ahead of that. AudioQueue adds its own internal latency on top — if
+// pan lag is still objectionable, the real fix is a low-latency backend
+// (AVAudioSourceNode / AURemoteIO) pulling the same lock-free ring.
+#define AQ_BUFFER_COUNT   3
+#define AQ_FRAMES_PER_BUF 512
+
+static AudioQueueRef s_aq;
+static qboolean      s_aq_running;
+
+static void AQ_Callback( void *userdata, AudioQueueRef aq, AudioQueueBufferRef buf )
+{
+	int   len = (int)buf->mAudioDataBytesCapacity;
+	byte *stream = buf->mAudioData;
+	const int size = snd.samples << 1;
+	int   pos, wrapped;
+
+	pos = snd.samplepos << 1;
+	if( pos >= size )
+		pos = 0;
+
+	wrapped = pos + len - size;
+
+	if( wrapped < 0 )
+	{
+		memcpy( stream, snd.buffer + pos, len );
+		pos += len;
+	}
+	else
+	{
+		int remaining = size - pos;
+
+		memcpy( stream, snd.buffer + pos, remaining );
+		memcpy( stream + remaining, snd.buffer, wrapped );
+		pos = wrapped;
+	}
+
+	if( pos >= size )
+		pos = 0;
+
+	__atomic_store_n( &snd.samplepos, pos >> 1, __ATOMIC_RELEASE );
+
+	buf->mAudioDataByteSize = buf->mAudioDataBytesCapacity;
+	AudioQueueEnqueueBuffer( aq, buf, 0, NULL );
+}
+
+/*
+==================
+SNDDMA_Init
+
+Try to find a sound device to mix for.
+Returns false if nothing is found.
+==================
+*/
+qboolean SNDDMA_Init( void )
+{
+	AudioStreamBasicDescription fmt = { 0 };
+	OSStatus err;
+	int      samplecount, i;
+
+	fmt.mSampleRate       = SOUND_DMA_SPEED;
+	fmt.mFormatID         = kAudioFormatLinearPCM;
+	fmt.mFormatFlags      = kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked;
+	fmt.mChannelsPerFrame = 2;
+	fmt.mBitsPerChannel   = 16;
+	fmt.mBytesPerFrame    = 4; // 2 ch × 16 bit
+	fmt.mFramesPerPacket  = 1;
+	fmt.mBytesPerPacket   = 4;
+
+	err = AudioQueueNewOutput( &fmt, AQ_Callback, NULL, NULL, NULL, 0, &s_aq );
+	if( err != noErr )
+	{
+		Con_Printf( "Couldn't open AudioQueue output (err=%d)\n", (int)err );
+		return false;
+	}
+
+	snd.format.speed    = SOUND_DMA_SPEED;
+	snd.format.channels = 2;
+	snd.format.width    = 2;
+	samplecount = s_samplecount.value;
+	if( !samplecount )
+		samplecount = 0x8000;
+	snd.samples         = samplecount * snd.format.channels;
+	snd.buffer          = Mem_Calloc( sndpool, snd.samples * 2 );
+	snd.samplepos       = 0;
+
+	// Prime and enqueue silence so the queue has buffers in rotation
+	// before the first mix.
+	for( i = 0; i < AQ_BUFFER_COUNT; i++ )
+	{
+		AudioQueueBufferRef buf = NULL;
+
+		err = AudioQueueAllocateBuffer( s_aq, AQ_FRAMES_PER_BUF * fmt.mBytesPerFrame, &buf );
+		if( err != noErr )
+		{
+			Con_Printf( "AudioQueueAllocateBuffer failed (err=%d)\n", (int)err );
+			SNDDMA_Shutdown( );
+			return false;
+		}
+
+		memset( buf->mAudioData, 0, buf->mAudioDataBytesCapacity );
+		buf->mAudioDataByteSize = buf->mAudioDataBytesCapacity;
+		AudioQueueEnqueueBuffer( s_aq, buf, 0, NULL );
+	}
+
+	snd.initialized  = true;
+	snd.backend_name = "AudioQueue";
+
+	Con_Printf( "Using AudioQueue audio @ %d Hz\n", (int)SOUND_DMA_SPEED );
+
+	SNDDMA_Activate( true );
+
+	return true;
+}
+
+/*
+==============
+SNDDMA_BeginPainting
+
+Makes sure snd.buffer is valid
+===============
+*/
+void SNDDMA_BeginPainting( void )
+{
+	// Lock-free ring (see AQ_Callback) — nothing to acquire.
+}
+
+/*
+==============
+SNDDMA_Submit
+
+Send sound to device if buffer isn't really the dma buffer
+Also unlocks the dsound buffer
+===============
+*/
+void SNDDMA_Submit( void )
+{
+	// Lock-free ring (see AQ_Callback) — nothing to release.
+}
+
+/*
+==============
+SNDDMA_Shutdown
+
+Reset the sound device for exiting
+===============
+*/
+void SNDDMA_Shutdown( void )
+{
+	Con_Printf( "Shutting down audio.\n" );
+	snd.initialized = false;
+
+	if( s_aq )
+	{
+		// true = stop synchronously; the callback can't fire after this,
+		// so freeing snd.buffer below is safe. Also frees queue buffers.
+		AudioQueueStop( s_aq, true );
+		AudioQueueDispose( s_aq, true );
+		s_aq = NULL;
+		s_aq_running = false;
+	}
+
+	if( snd.buffer )
+	{
+		Mem_Free( snd.buffer );
+		snd.buffer = NULL;
+	}
+}
+
+/*
+===========
+SNDDMA_Activate
+Called when the app gains or loses focus.
+===========
+*/
+void SNDDMA_Activate( qboolean active )
+{
+	if( !s_aq )
+		return;
+
+	if( active && !s_aq_running )
+	{
+		// Silence the ring before resuming: while the app was suspended the
+		// mixer (GL worker) stopped painting, so the ring still holds the
+		// last ~0.74 s of audio. Restarting the queue before the mixer
+		// repaints would replay that stale content on a loop (observed on
+		// resume with the game hidden). Zeroed ring → the callback streams
+		// silence until the first fresh mix lands.
+		if( snd.buffer )
+		{
+			memset( snd.buffer, 0, snd.samples * 2 );
+			__atomic_store_n( &snd.samplepos, 0, __ATOMIC_RELEASE );
+		}
+		// NOTE: do NOT AudioQueueReset here — Reset removes the enqueued
+		// buffers WITHOUT returning them through the callback, so the queue
+		// starts with zero buffers, the callback never fires to re-enqueue,
+		// and output is silent forever (observed: total silence). The ring
+		// memset above is enough to kill the resume loop; the ~70 ms already
+		// copied into the 3 in-flight buffers plays out harmlessly.
+		if( AudioQueueStart( s_aq, NULL ) == noErr )
+			s_aq_running = true;
+	}
+	else if( !active && s_aq_running )
+	{
+		AudioQueuePause( s_aq );
+		s_aq_running = false;
+	}
+}
+
+qboolean VoiceCapture_Init( void )
+{
+	return false;
+}
+
+qboolean VoiceCapture_Activate( qboolean activate )
+{
+	return false;
+}
+
+qboolean VoiceCapture_Lock( qboolean lock )
+{
+	return false;
+}
+
+void VoiceCapture_Shutdown( void )
+{
+}
