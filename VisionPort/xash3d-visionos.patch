 void *GL_GetProcAddress( const char *name )
 {
-	(void)name;
-	return NULL;
+	// ref_gles3compat resolves every pgl* via this hook. PREFER ANGLE's
+	// eglGetProcAddress over dlsym(RTLD_DEFAULT). When linked with
+	// libANGLE.a via -force_load, the GLES entry points (glGetString,
+	// glCreateShader, ...) appear in the dyld symbol table BUT through
+	// public-API wrappers that are inert until ANGLE-internal state is
+	// fully set up. eglGetProcAddress returns the real dispatch-table
+	// entry, which works as soon as a context is current. Symptom of
+	// using dlsym: pglGetString returns NULL even though the direct
+	// (link-time) glGetString call works on the same context+thread.
+	if( !name ) return NULL;
+	void *fn = eglGetProcAddress( name );
+	if( !fn ) fn = dlsym( RTLD_DEFAULT, name );
+	return fn;
 }
 
