+// VR barrel aim: the server adds g_vr_aim_offset to pev->v_angle inside
+// CBasePlayer::ItemPostFrame (dlls/player.cpp) so shots fire along the weapon
+// barrel (the hand direction) rather than the head view. The client event
+// trace that draws the bullet-hole decal + tracer reads args->angles — the
+// head view, with NO offset — so without this the visual "lied": the hole
+// appeared along the gaze while the damage went along the barrel. Apply the
+// same offset to the client trace angles so the decal/tracer match the hit.
+// We read g_vr_aim_offset_cl (defined client-side in view.cpp, written by the
+// bridge) rather than the server's g_vr_aim_offset — the intermediate cl_dll
+// dylib link has no server symbols. Local player only (the offset is the host
+// player's; remote players in MP carry their own args->angles). Egon is exempt,
+// matching the server-side and render-side exemptions — it fires along the view.
+extern "C" float g_vr_aim_offset_cl[2];  // defined in cl_dll/view.cpp
+static void EV_VR_ApplyAimOffset( event_args_t *args, float *angles )
+{
+	if( !EV_IsLocal( args->entindex ) )
+		return;
+	angles[PITCH] += g_vr_aim_offset_cl[0];
+	angles[YAW]   += g_vr_aim_offset_cl[1];
+}
+
+// VR muzzle origin: the server fires from the muzzle of the gun in the hand
+// (CBasePlayer::GetGunPosition, g_vr_muzzle_offset); move the client trace's
+// start the same way, with the same eye→muzzle wall check, so the tracer
+// and the decal leave the drawn barrel. g_vr_muzzle_offset_cl is its mirror
+// (cl_dll/view.cpp): muzzle relative to the eye in the level frame of the
+// view yaw, [3] > 0 while active. Called right after EV_GetGunPosition.
+extern "C" float g_vr_muzzle_offset_cl[4];  // defined in cl_dll/view.cpp
+static void EV_VR_ApplyMuzzle( event_args_t *args, float *vecSrc )
+{
+	if( !EV_IsLocal( args->entindex ) || g_vr_muzzle_offset_cl[3] <= 0.0f )
+		return;
+	const float *o = g_vr_muzzle_offset_cl;
+	float yaw = args->angles[YAW] * 0.017453293f;
+	float c = cosf( yaw ), s = sinf( yaw );
+	vec3_t muzzle;
+	muzzle[0] = vecSrc[0] + c * o[0] - s * o[1];
+	muzzle[1] = vecSrc[1] + s * o[0] + c * o[1];
+	muzzle[2] = vecSrc[2] + o[2];
+	pmtrace_t *tr = gEngfuncs.PM_TraceLine( vecSrc, muzzle, PM_TRACELINE_PHYSENTSONLY, 2, -1 );
+	if( tr && tr->fraction >= 1.0f && !tr->startsolid && !tr->allsolid )
+		VectorCopy( muzzle, vecSrc );
+}
