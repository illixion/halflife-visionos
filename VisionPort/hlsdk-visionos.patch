@@ -43,6 +43,30 @@ NSWITCH_ENVVARS = ['DEVKITPRO']
 PSVITA_ENVVARS = ['VITASDK']
 
 # This class does support ONLY r10e and r19c/r20 NDK
+class visionOS:
+	ctx = None
+	sdkpath = None
+	target = None
+
+	def __init__(self, ctx, issim):
+		self.ctx = ctx
+		sdk = 'xrsimulator' if issim else 'xros'
+		self.sdkpath = ctx.cmd_and_log('xcrun --show-sdk-path --sdk %s' % sdk).strip()
+		self.target = '--target=arm64-apple-xros2.0'
+		if issim: self.target += '-simulator'
+
+	def cflags(self, cxx=False):
+		return ['-isysroot' + self.sdkpath, self.target]
+
+	def linkflags(self):
+		return ['-isysroot' + self.sdkpath, self.target]
+
+	def cc(self):
+		return 'clang'
+
+	def cxx(self):
+		return 'clang++'
+
 class Android:
 	ctx            = None # waf context
 	arch           = None
