+		help='enable building for visionOS [default: %(default)s]')
+	xc.add_option('--xros-simulator', action='store_true', dest='XROSSIM', default=False,
+		help='enable building for visionOS Simulator [default: %(default)s]')
 
 def configure(conf):
 	if 'CROSS_COMPILE' in conf.environ:
@@ -636,6 +664,16 @@ def configure(conf):
 		conf.env.LIB_M = ['m']
 		conf.env.VRTLD = ['vrtld']
 		conf.env.DEST_OS = 'psvita'
+	elif conf.options.XROS or conf.options.XROSSIM:
+		issim = bool(conf.options.XROSSIM)
