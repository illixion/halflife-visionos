diff --git a/dlls/player.cpp b/dlls/player.cpp
index a31504f..ca4a2eb 100644
--- a/dlls/player.cpp
+++ b/dlls/player.cpp
@@ -47,6 +47,14 @@ extern DLL_GLOBAL int g_iSkillLevel, gDisplayTitle;
 
 BOOL gInitHUD = TRUE;
 
+// VR (LambdaVision): angular offset of the aim ray from the view
+// direction (pitch, yaw — degrees), written per frame by the platform
+// bridge. Applied around the weapon frame in CBasePlayer::ItemPostFrame
+// so weapons fire along the player's gaze/hand ray while view, movement
+// and pmove stay on the real view angles. Default visibility: the ld -r
+// prelink localizes hidden symbols and the bridge externs this by name.
+extern "C" __attribute__((visibility("default"))) float g_vr_aim_offset[2] = { 0.0f, 0.0f };
+
 extern void CopyToBodyQue( entvars_t *pev);
 extern void respawn( entvars_t *pev, BOOL fCopyCorpse );
 extern Vector VecBModelOrigin( entvars_t *pevBModel );
@@ -3930,7 +3938,18 @@ void CBasePlayer::ItemPostFrame()
 	if( !m_pActiveItem )
 		return;
 
-	m_pActiveItem->ItemPostFrame();
+	// VR aim: fire along the platform-supplied aim ray (gaze or hand),
+	// scoped to the weapon frame — UTIL_MakeVectors, GetAutoaimVector and
+	// GetGunPosition all read v_angle, so every weapon inherits the ray.
+	{
+		Vector vrSavedAngle = pev->v_angle;
+		pev->v_angle.x += g_vr_aim_offset[0];
+		pev->v_angle.y += g_vr_aim_offset[1];
+
+		m_pActiveItem->ItemPostFrame();
+
+		pev->v_angle = vrSavedAngle;
+	}
 }
 
 int CBasePlayer::AmmoInventory( int iAmmoIndex )
