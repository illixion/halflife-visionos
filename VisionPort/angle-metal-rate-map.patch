diff --git a/src/libANGLE/renderer/metal/mtl_rate_map_export.mm b/src/libANGLE/renderer/metal/mtl_rate_map_export.mm
new file mode 100644
index 0000000000..ba7d10ef61
--- /dev/null
+++ b/src/libANGLE/renderer/metal/mtl_rate_map_export.mm
@@ -0,0 +1,45 @@
+//
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// mtl_rate_map_export.mm:
+//    visionOS port (LambdaVision, angle-metal-rate-map.patch): rasterize a
+//    framebuffer object through a Metal variable rasterization rate map, so a
+//    GL renderer can draw foveated into EGLImage-wrapped Metal textures. The
+//    viewport and scissor are then in the map's screen space and the
+//    attachments hold its physical texels; reads of the result have to decode
+//    the layout themselves.
+//
+
+#include "export.h"
+#include "libANGLE/Context.h"
+#include "libANGLE/Framebuffer.h"
+#include "libANGLE/renderer/metal/ContextMtl.h"
+#include "libANGLE/renderer/metal/FrameBufferMtl.h"
+#include "libANGLE/renderer/metal/SurfaceMtl.h"
+#include "libANGLE/renderer/metal/mtl_common.h"
+#include "libGLESv2/global_state.h"
+
+// On the thread whose context owns `framebuffer`: from its next render pass
+// on, it rasterizes through `rateMap` (an id<MTLRasterizationRateMap> with one
+// layer; retained), or through none for NULL. Returns 1 when it took, 0 when
+// the device can't, -1 without a current context, -2 for no such framebuffer
+// object.
+extern "C" ANGLE_EXPORT int ANGLE_SetFramebufferRasterizationRateMap(unsigned int framebuffer,
+                                                                    void *rateMap)
+{
+    gl::Context *context = gl::GetValidGlobalContext();
+    if (!context)
+    {
+        return -1;
+    }
+    SCOPED_SHARE_CONTEXT_LOCK(context);
+    gl::Framebuffer *fb = context->getFramebuffer(gl::FramebufferID{framebuffer});
+    if (!fb || fb->isDefault())
+    {
+        return -2;
+    }
+    id<MTLRasterizationRateMap> map = static_cast<id<MTLRasterizationRateMap>>(rateMap);
+    return rx::mtl::GetImpl(fb)->setRasterizationRateMap(context, map) ? 1 : 0;
+}
