+    // visionOS port (angle-metal-rate-map.patch): the framebuffer's variable
+    // rasterization rate map, nil for none. Viewports and scissors are then in
+    // its screen space, which the attachments' physical texels hold.
+    angle::ObjCPtr<id<MTLRasterizationRateMap>> rasterizationRateMap;
 };
 
