+gl::Rectangle FramebufferMtl::getRasterArea() const
+{
+    if (mRasterizationRateMap)
+    {
+        const MTLSize screen = mRasterizationRateMap.get().screenSize;
+        return gl::Rectangle(0, 0, static_cast<int>(screen.width), static_cast<int>(screen.height));
+    }
+    return getCompleteRenderArea();
+}
+
+bool FramebufferMtl::setRasterizationRateMap(const gl::Context *context,
+                                             id<MTLRasterizationRateMap> map)
+{
+    ContextMtl *contextMtl = mtl::GetImpl(context);
+    if (map && ![contextMtl->getMetalDevice().get() supportsRasterizationRateMapWithLayerCount:1])
+    {
+        return false;
+    }
+    if (mRasterizationRateMap.get() == map)
+    {
+        return true;
+    }
+    mRasterizationRateMap                = map;
+    mRenderPassDesc.rasterizationRateMap = mRasterizationRateMap;
+    // A new render pass from the next draw, and the viewport and scissor
+    // recomputed against the map's screen.
+    if (mtl::GetImpl(context->getState().getDrawFramebuffer()) == this)
+    {
+        contextMtl->onDrawFrameBufferChangedState(context, this, true);
+    }
+    return true;
+}
