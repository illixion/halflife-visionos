diff --git a/src/libANGLE/renderer/metal/mtl_command_buffer.mm b/src/libANGLE/renderer/metal/mtl_command_buffer.mm
index b019051d74..81a3ecc4b7 100644
--- a/src/libANGLE/renderer/metal/mtl_command_buffer.mm
+++ b/src/libANGLE/renderer/metal/mtl_command_buffer.mm
@@ -28,6 +28,34 @@
 #include "libANGLE/renderer/metal/mtl_resources.h"
 #include "libANGLE/renderer/metal/mtl_utils.h"
 
+#include <atomic>
+
+// Render pass statistics for the embedding app (LambdaVision's engine MSAA
+// checks): render encoders started, and the multisampled attachments
+// FramebufferMtl had to unresolve (reload from their resolved image) because
+// a framebuffer's work was split across render passes.
+std::atomic<unsigned long long> gRenderPassesStarted{0};
+std::atomic<unsigned long long> gRenderPassUnresolves{0};
+
+extern "C" __attribute__((visibility("default"))) void ANGLE_GetRenderPassStats(
+    unsigned long long *passes,
+    unsigned long long *unresolves)
+{
+    if (passes)
+        *passes = gRenderPassesStarted.load(std::memory_order_relaxed);
+    if (unresolves)
+        *unresolves = gRenderPassUnresolves.load(std::memory_order_relaxed);
+}
+
+// Called as a render encoder ends, on the thread ending it, so the embedding
+// app can take a backtrace of whatever split a pass it meant to keep whole.
+static std::atomic<void (*)(void)> gRenderPassEndHook{nullptr};
+
+extern "C" __attribute__((visibility("default"))) void ANGLE_SetRenderPassEndHook(void (*hook)(void))
+{
+    gRenderPassEndHook.store(hook, std::memory_order_relaxed);
+}
+
 // Use to compare the new values with the values already set in the command encoder:
 static inline bool operator==(const MTLViewport &lhs, const MTLViewport &rhs)
 {
@@ -1501,6 +1529,8 @@ void RenderCommandEncoder::endEncodingImpl(bool considerDiscardSimulation)
 {
     if (!valid())
         return;
+    if (void (*hook)(void) = gRenderPassEndHook.load(std::memory_order_relaxed))
+        hook();
 
     bool hasAttachment = false;
 
@@ -1723,6 +1753,8 @@ RenderCommandEncoder &RenderCommandEncoder::restart(const RenderPassDesc &desc,
         return *this;
     }
 
+    gRenderPassesStarted.fetch_add(1, std::memory_order_relaxed);
+
     mSerial                   = cmdBuffer().cmdQueue().getNextRenderPassEncoderSerial();
     mRenderPassDesc           = desc;
     mRecording                = true;
